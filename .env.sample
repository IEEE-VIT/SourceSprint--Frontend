# SourceSprint Frontend — environment variables
# Copy this file to `.env` and fill in the value. CRA only exposes vars that
# start with REACT_APP_, and it reads them at BUILD time (not run time), so you
# must rebuild after changing this.

# Base URL of the SourceSprint backend API (no trailing slash).
# Local dev:  http://localhost:5000
# Production: https://<your-backend-host>   e.g. https://sourcesprint-api.onrender.com
REACT_APP_BACKEND_URL=http://localhost:5000
